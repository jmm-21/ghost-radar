# Copia este archivo como .env.local para desarrollo. Todas las variables son opcionales:
# sin ellas, la API usa memoria y todo funciona igual (pero los datos no persisten).

# Redis (Upstash). En Vercel se rellenan solas al añadir la integración de Upstash.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Token para leer las opiniones: GET /api/feedback con "Authorization: Bearer <token>"
ADMIN_TOKEN=

# Sal para anonimizar a los clientes en el límite de peticiones (cualquier texto largo y aleatorio)
HASH_SALT=
